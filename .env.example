# Supabase — Project Settings → API
#
# ⚠️  Project URL phải là URL GỐC của project, KHÔNG kèm /rest/v1/ hay /auth/v1/.
#     Đúng:  https://abcdefghijklm.supabase.co
#     Sai:   https://abcdefghijklm.supabase.co/rest/v1/
#
# ⚠️  Không có khoảng trắng thừa ở cuối giá trị.
#
# Kiểm tra nhanh sau khi điền: npm run check:env

# Bắt buộc
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (khuyến nghị mới) hoặc anon key (cũ).
# Dùng publishable key cho frontend — an toàn hơn anon key.
# Nếu dùng tên biến cũ, đổi NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# thành NEXT_PUBLIC_SUPABASE_ANON_KEY (code hỗ trợ cả hai).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chỉ dùng server-side (script seed:images, storage admin). KHÔNG đưa vào client.
SUPABASE_SERVICE_ROLE_KEY=

# Personal access token cho Supabase CLI / Management API.
# Chỉ cần khi chạy `npm run db:push`. Tạo tại:
# https://supabase.com/dashboard/account/tokens  (scope: database_write)
# KHÔNG commit token này — nó có quyền quản trị project.
SUPABASE_ACCESS_TOKEN=

# Site — dùng domain thật khi deploy (ảnh OG, sitemap, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------
# Google Search Console / Bing Webmaster
# ------------------------------------------------------------------
# Mã xác minh Google Search Console (Thuộc tính → Xác minh → HTML thẻ).
# Render thành <meta name="google-site-verification" content="..."> trong <head>.
#
# Dùng cho CẢ HAI cách xác minh:
#   1. HTML thẻ  → thẻ meta trong <head> (đã tích hợp sẵn)
#   2. HTML file → file /google<token>.html (tự sinh từ biến này qua rewrite)
#
# Set trên Vercel (Production + Preview) rồi deploy lại là xác minh được,
# KHÔNG cần sửa code.
GOOGLE_SITE_VERIFICATION=

# Mã xác minh Bing Webmaster (tuỳ chọn) → <meta name="msvalidate.01">
BING_SITE_VERIFICATION=

# ------------------------------------------------------------------
# Kiểm thử hiệu năng (CÔNG CỤ — MẶC ĐỊNH TẮT)
# ------------------------------------------------------------------
# Cố tình làm hỏng chỉ số hiệu năng của trang chủ để benchmark / test UI khi
# trang tải chậm. ĐỂ TRỐNG = trang chạy bình thường (điểm Performance ~82).
#
# Cú pháp: <cờ>[:<cường độ>][,<cờ>[:<cường độ>]…]
#
#   tbt     khoá Main Thread         → TBT tăng (30% tổng điểm)   mặc định 500ms
#   cls     banner cao chèn muộn     → CLS tăng (25% tổng điểm)   mặc định 150px
#   lcp     trì hoãn hiện ảnh hero   → LCP tăng (25% tổng điểm)   mặc định 1500ms
#   delay   trì hoãn render nội dung→ LCP tăng (25% tổng điểm)   mặc định 1500ms
#   heavy   ảnh hero nặng ~2.4MB     → LCP tăng mạnh (cần `npm run perf:heavy-image`)
#   all     bật tất cả
#
# Ví dụ (đo thực tế bằng Lighthouse, preset mobile, trên production):
#   NEXT_PUBLIC_PERF_DEGRADE=                          # tắt → ~82
#   NEXT_PUBLIC_PERF_DEGRADE=tbt:300,lcp:1500,cls:180  # → ~50 (preset khuyến nghị)
#   NEXT_PUBLIC_PERF_DEGRADE=tbt:500                   # → ~67
#
# ⚠️ KHÔNG set trên production nếu không cố ý — người dùng thật sẽ phải chờ.
NEXT_PUBLIC_PERF_DEGRADE=

# ------------------------------------------------------------------
# Bài viết (blog)
# ------------------------------------------------------------------
# Bài viết lưu trong Supabase (bảng `posts`), admin quản lý tại
# `/admin/posts`. Không cần cấu hình thêm gì.

# Host ảnh ngoài được phép tải qua Next.js Image Optimizer — dùng khi admin
# dán URL ảnh từ nguồn khác (không phải Supabase Storage).
# Phân tách nhiều host bằng dấu phẩy. Để trống nếu không dùng.
IMAGE_REMOTE_HOSTS=
